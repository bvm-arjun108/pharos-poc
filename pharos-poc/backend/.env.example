# ---- AWS / Bedrock ----
AWS_REGION=us-east-1
# Use a model you have access to in the Bedrock console (Model access page).
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
# Optional Bedrock Guardrail:
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=DRAFT

# Set to "true" to run the full stack WITHOUT AWS (rule-based grades).
# Set to "false" to use real Strands + Bedrock agents.
USE_MOCK_AGENTS=false

# ---- Case data source ----
# "mock" = built-in sample cases (no Snowflake needed).
# "real" = query Snowflake (fill in the credentials below).
SNOWFLAKE_MODE=mock

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173

# ---- Snowflake (only used when SNOWFLAKE_MODE=real) ----
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_SCHEMA=
# SNOWFLAKE_ROLE=
